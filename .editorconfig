root = true

# line endings are left to git (.gitattributes: text=auto)
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[site/**.{html,css,js,mjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
